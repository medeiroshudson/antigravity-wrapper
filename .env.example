# --- API ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Ingress credential. Required; no whitespace and no commas.
API_KEY=
LOG_LEVEL=info
APP_LOCALE=en-US
# Max request body in bytes before a 413. Default 32 MiB: well above the 1 MiB
# Fastify default, which refused large agent turns (big system prompt + tools).
BODY_LIMIT_BYTES=33554432

# --- Storage --------------------------------------------------------------
DB_PATH=./data/antigravity.db

# --- OAuth client (required; no secret is embedded in the code) -----------
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# --- Protocol -------------------------------------------------------------
# Upstream override; https only, and the host must be *.googleapis.com.
# ANTIGRAVITY_BASE_URL=
# Full fingerprint override; when set, the five parts below are ignored.
# ANTIGRAVITY_USER_AGENT=
# Fingerprint parts. Measured from the installed client on 2026-11-09:
#   antigravity/cli/1.5.3 (aidev_client; os_type=darwin; arch=arm64; cl=1016078699; auth_method=consumer)
# os_type and arch follow the running process; version and cl follow the client release
# (the language server prints the latter as "Built at CL: ..." with --stamp).
# ANTIGRAVITY_UA_PRODUCT=antigravity
# ANTIGRAVITY_SUBCLIENT=cli
# ANTIGRAVITY_CLIENT_VERSION=1.5.3
# ANTIGRAVITY_CLIENT_BUILD=1016078699
# ANTIGRAVITY_AUTH_METHOD=consumer
# Enable Google Search Grounding by default on all Gemini chat completions (false)
# ANTIGRAVITY_SEARCH_AUTO=false

# --- Timeouts and TTLs (ms) -----------------------------------------------
UPSTREAM_TIMEOUT_MS=120000
STREAM_HEADER_TIMEOUT_MS=180000
STREAM_STALL_TIMEOUT_MS=120000
QUOTA_REFRESH_TTL_MS=300000
MODELS_TTL_MS=14400000
# Fallback cooldown when a quota wall names no reset time.
COOLDOWN_TRANSIENT_MS=60000
# Wait before retrying the same account after a transient throttle. 0 retries at once.
TRANSIENT_RETRY_BACKOFF_MS=1000
# How long a stream:true request waits for the first content byte before the SSE
# head is flushed anyway. 0 flushes immediately. Instant failures (empty pool,
# validation) keep their real HTTP status under this patience; slow ones become
# error frames inside the 200.
STREAM_FLUSH_PATIENCE_MS=1500

# --- Load balancing -------------------------------------------------------
MAX_FAILOVER_ATTEMPTS=3
