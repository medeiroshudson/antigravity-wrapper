# --- API ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Ingress credential. Required; no whitespace and no commas.
API_KEY=
LOG_LEVEL=info
APP_LOCALE=en-US

# --- Storage --------------------------------------------------------------
DB_PATH=./data/antigravity.db

# --- OAuth client (required; no secret is embedded in the code) -----------
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# --- Protocol -------------------------------------------------------------
# Upstream override; https only, and the host must be *.googleapis.com.
# ANTIGRAVITY_BASE_URL=
# ANTIGRAVITY_USER_AGENT=

# --- Timeouts and TTLs (ms) -----------------------------------------------
UPSTREAM_TIMEOUT_MS=120000
STREAM_HEADER_TIMEOUT_MS=180000
STREAM_STALL_TIMEOUT_MS=120000
QUOTA_REFRESH_TTL_MS=300000
MODELS_TTL_MS=14400000
# Fallback cooldown when a quota wall names no reset time.
COOLDOWN_TRANSIENT_MS=60000
# Wait before retrying the same account after a transient throttle. 0 retries at once.
TRANSIENT_RETRY_BACKOFF_MS=1000

# --- Load balancing -------------------------------------------------------
MAX_FAILOVER_ATTEMPTS=3
